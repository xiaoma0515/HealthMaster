<Window x:Class="HealthMaster.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="健康提醒"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        MouseLeftButtonDown="OnMouseLeftButtonDown">

    <Border Background="#E6202020" CornerRadius="10" Padding="14,9" MinWidth="118">
        <Grid>
            <!-- 折叠态：显示最近一项 -->
            <TextBlock Text="{Binding Compact}"
                       Foreground="#F2F2F2" FontSize="13" FontWeight="SemiBold"
                       TextAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 展开态：悬停显示四路倒计时 -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding Header}" Foreground="#8FD08F" FontSize="11" Margin="0,0,0,5" />
                <TextBlock Text="{Binding Eye}"       Foreground="#F2F2F2" FontSize="13" Margin="0,1" />
                <TextBlock Text="{Binding Sedentary}" Foreground="#F2F2F2" FontSize="13" Margin="0,1" />
                <TextBlock Text="{Binding Water}"     Foreground="#F2F2F2" FontSize="13" Margin="0,1" />
                <TextBlock Text="{Binding Exercise}"  Foreground="#F2F2F2" FontSize="13" Margin="0,1" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
