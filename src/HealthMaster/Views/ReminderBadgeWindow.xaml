<Window x:Class="HealthMaster.Views.ReminderBadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="健康提醒"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Opacity="0"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="46"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <!--
        Background="{x:Null}"：空背景不参与命中测试，圆形图标之外的窗口矩形对鼠标完全穿透，
        点击不会被这块透明区吞掉。（Transparent 会参与命中测试，故不可用。）
        Opacity="0"：首帧门控，定位算完后由代码置 1，避免在左上角闪一帧。
        Width="46"（= 图标 36 + 左右 Margin 各 5）写死、只让高度随图标数自适应：
        宽度若交给 SizeToContent 自适应，首帧会被系统最小窗口宽度（min-track）撑到 130+ DIP
        且此后不再收敛，图标会偏离预期位置；高度不受该限制，故仍可自适应。
    -->
    <Window.Resources>
        <!-- 提醒图标：圆底 + emoji 字形；悬停放大并加亮描边（纯触发器，无动画循环） -->
        <Style x:Key="BadgeButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Width="36" Height="36" CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#59FFFFFF" BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFFFFF" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ItemsControl ItemsSource="{Binding}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!-- 多类同时到点：从上到下竖排成一列 -->
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource BadgeButton}"
                        Margin="5"
                        Background="{Binding Accent}"
                        Content="{Binding Glyph}"
                        ToolTip="{Binding Tooltip}"
                        Tag="{Binding}"
                        Click="Badge_Click" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
