<Window x:Class="HealthMaster.Views.ReminderBadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="健康提醒"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Opacity="0"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="46"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource Font.UI}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

    <!--
        Background="{x:Null}"：空背景不参与命中测试，圆形图标之外的窗口矩形对鼠标完全穿透，
        点击不会被这块透明区吞掉。（Transparent 会参与命中测试，故不可用。）
        Opacity="0"：首帧门控，定位算完后由代码置 1，避免在左上角闪一帧。
        Width="46"（= 图标 34 + 左右 Margin 各 6）写死、只让高度随图标数自适应：
        宽度若交给 SizeToContent 自适应，首帧会被系统最小窗口宽度（min-track）撑到 130+ DIP
        且此后不再收敛，图标会偏离预期位置；高度不受该限制，故仍可自适应。
        v2 把直径 36+Margin5 调成 34+Margin6，总宽仍**恰好 46**，为图标外阴影与悬停放大
        腾出各 6px 余量（外扩量核算见 Themes/Controls.xaml 的 S.Badge 注释）。
    -->

    <ItemsControl ItemsSource="{Binding}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!-- 多类同时到点：从上到下竖排成一列 -->
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!-- 尺寸 / 渐变圆底 / 内高光 / 阴影 / 三态反馈全部在 Themes/Controls.xaml 的 S.Badge，
                     圆底颜色按 Type 静态映射，故此处不再本地设 Background（本地值会压过样式触发器）。 -->
                <Button Style="{StaticResource S.Badge}"
                        ToolTip="{Binding Tooltip}"
                        Tag="{Binding}"
                        Click="Badge_Click">
                    <!-- 内置矢量图形（ReminderBadgeItem.Icon），不引入外部图片 / 字体文件 -->
                    <Path Data="{Binding Icon}"
                          Fill="{DynamicResource Brush.Badge.Icon}" Stretch="Uniform"
                          Width="{StaticResource Sz.BadgeIcon}" Height="{StaticResource Sz.BadgeIcon}" />
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
